"delayUntilIntervalDays": "0"
}</text>
        </outputEntry>
        <outputEntry id="OutputEntry_initiation_5_6">
          <text>"CHANGE_LATER_PROCESS_CATEGORIES"</text>
        </outputEntry>
      </rule>
      <rule id="Rule_initiation_6">
        <inputEntry id="InputEntry_initiation_6_1">
          <text>"FR_respondToOrder"</text>
        </inputEntry>
        <inputEntry id="InputEntry_initiation_6_2">
