  <decision id="wa-task-initiation-divorce-financialremedymvp2" name="Task initiation DMN"
            camunda:historyTimeToLive="P90D">
    <decisionTable id="DecisionTable_initiation_consented" hitPolicy="COLLECT">
      <input id="Input_1" label="Event Id" camunda:inputVariable="eventId">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="Input_2" label="Post event state" camunda:inputVariable="postEventState">
        <inputExpression id="InputExpression_2" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="Input_3" label="Supplementary evidence handled" camunda:inputVariable="evidenceHandled">
        <inputExpression id="InputExpression_3" typeRef="string">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.evidenceHandled !=
            null) then additionalData.Data.evidenceHandled else ""
          </text>
        </inputExpression>
      </input>
      <input id="InputClause_0prpqwj" label="Pension documents present" camunda:inputVariable="pensionDocumentsCount">
        <inputExpression id="LiteralExpression_1yika90" typeRef="integer">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.pensionCollection !=
            null) then count(additionalData.Data.pensionCollection) else 0
          </text>
        </inputExpression>
      </input>
      <input id="Input_5" label="Hearing to be listed or manual refusal reason entered"
             camunda:inputVariable="reviewRefusedHearingOrManualReason">
        <inputExpression id="InputExpression_5" typeRef="boolean">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.orderRefusalCollection
            != null) then (some refusal in additionalData.Data.orderRefusalCollection satisfies
            ((refusal.value.orderRefusal != null and list contains(refusal.value.orderRefusal, "Hearing fixed for first
            available date")) or (refusal.value.orderRefusalOther != null and refusal.value.orderRefusalOther != "")))
            else false
          </text>
        </inputExpression>
      </input>
      <input id="Input_6" label="Help with fees" camunda:inputVariable="helpWithFeesQuestion">
        <inputExpression id="InputExpression_6" typeRef="string">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.helpWithFeesQuestion
            != null) then additionalData.Data.helpWithFeesQuestion else ""
          </text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Task Id" name="taskId" typeRef="string"/>
      <output id="Output_2" label="Name" name="name" typeRef="string"/>
      <output id="Output_4" label="Delay Duration" name="delayDuration" typeRef="integer"/>
      <output id="Output_6" label="Delay Until" name="delayUntil" typeRef="json"/>
      <output id="Output_7" label="Process Categories" name="processCategories" typeRef="string"/>
