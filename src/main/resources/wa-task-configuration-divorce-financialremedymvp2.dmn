  <decision id="wa-task-configuration-divorce-financialremedymvp2" name="Task configuration DMN"
            camunda:historyTimeToLive="P90D">
    <decisionTable id="DecisionTable_configuration_consented" hitPolicy="RULE ORDER">
      <input id="Input_1" label="CCD Case Data" camunda:inputVariable="caseData">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="Input_2" label="Task type" camunda:inputVariable="taskType">
        <inputExpression id="InputExpression_2" typeRef="string">
          <text>if(taskAttributes != null and taskAttributes.taskType != null) then
            taskAttributes.taskType
            else if(taskType != null) then
            taskType
            else
            null
          </text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Name" name="name" typeRef="string"/>
      <output id="Output_2" label="Value" name="value" typeRef="string"/>
      <output id="Output_3" label="Can Reconfigure?" name="canReconfigure" typeRef="boolean"/>
