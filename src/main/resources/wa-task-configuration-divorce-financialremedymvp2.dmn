          <text></text>
        </inputEntry>
        <outputEntry id="Rule_config_generic_4_out1">
          <text>"nextHearingDate"</text>
        </outputEntry>
        <outputEntry id="Rule_config_generic_4_out2">
          <text>if (caseData != null and caseData.listForHearings != null and
            count(caseData.listForHearings[date(value.hearingDate) &gt;= today()]) &gt; 0) then
            sort(caseData.listForHearings[date(value.hearingDate) &gt;= today()], function(x,y)
            date(y.value.hearingDate) &gt; date(x.value.hearingDate))[1].value.hearingDate else ""
          </text>
        </outputEntry>
        <outputEntry id="Rule_config_generic_4_out3">
          <text>true</text>
        </outputEntry>
      </rule>
