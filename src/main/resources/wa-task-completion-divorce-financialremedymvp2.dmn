        <outputEntry id="LiteralExpression_1uss2qt">
          <text>"processApprovedOrder"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0qwmt32">
          <text>"Auto"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1qfkvar">
