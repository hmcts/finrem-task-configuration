        <outputEntry id="LiteralExpression_0lvogeo">
          <text>"Auto"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_02vgolj">
        <description></description>
        <inputEntry id="UnaryTests_1iyu0vc">
          <text>"FR_approveApplication","FR_uploadApprovedOrder","FR_orderRefusal"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0cvxwds">
          <text>"reviewApplication"</text>
