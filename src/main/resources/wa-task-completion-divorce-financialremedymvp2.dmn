             xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="wa-completion-consented" name="DRD"
             namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <decision id="wa-task-completion-divorce-financialremedymvp2" name="Task completion DMN"
            camunda:historyTimeToLive="P90D">
    <decisionTable id="DecisionTable_completion_consented" hitPolicy="COLLECT">
      <input id="Input_1" label="Event ID" biodi:width="614">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>eventId</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Task Type" name="taskType" typeRef="string"/>
      <output id="Output_2" label="Completion Mode" name="completionMode" typeRef="string"/>
      <rule id="Rule_completion_1">
        <inputEntry id="InputEntry_completion_1_1">
          <text>"attachScannedDocs"</text>
        </inputEntry>
        <outputEntry id="OutputEntry_completion_1_1">
          <text>"processScannedDocuments"</text>
        </outputEntry>
        <outputEntry id="OutputEntry_completion_1_2">
          <text>"Auto"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0l0u2dt">
        <inputEntry id="UnaryTests_0zv6amo">
          <text>"FR_referToJudge","FR_issueApplication","FR_awaitingInfo","FR_generalEmail","FR_generalLetter","FR_generalOrderFromAwaitingInfo","FR_listForHearing","FR_close"</text>
